# Plantilla de variables de entorno.
# Copia este archivo como .env para desarrollo local (NUNCA subas .env a Git).

# Conexión a la base de datos:
# Local con Docker:  postgresql+psycopg2://sumarj:sumarj_password@db:5432/sumarj_db
# Neon:              postgresql://USER:PASS@HOST.neon.tech/DB?sslmode=require
DATABASE_URL=postgresql+psycopg2://sumarj:sumarj_password@db:5432/sumarj_db

# Llave secreta para firmar tokens JWT. En producción Render la genera automáticamente.
# Para generarla localmente:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=cambia-esta-llave-en-produccion

# Entorno: "development" o "production"
ENVIRONMENT=development
